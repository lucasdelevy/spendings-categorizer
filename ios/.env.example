# API Gateway base URL (no trailing slash)
EXPO_PUBLIC_API_URL=https://9kb7anm4rl.execute-api.us-east-1.amazonaws.com

# Google OAuth — iOS client ID from Google Cloud Console (bundle: com.lucasdelevy.aletheia)
